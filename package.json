{
  "name": "antalya-vip-limousine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "prebuild": "npm run check:prices && npm run generate:de-home && npm run generate:localized && npm run generate:privacy && npm run generate:impressum && npm run generate:sitemap",
    "check:prices": "node scripts/verify-prices.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "generate:de-home": "node scripts/build-de-homepage.mjs",
    "generate:localized": "node scripts/build-localized-pages.mjs",
    "generate:privacy": "node scripts/build-privacy-pages.mjs",
    "generate:impressum": "node scripts/build-impressum-pages.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:public": "vitest run scripts/public-site-contracts.test.js",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "libphonenumber-js": "^1.13.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
